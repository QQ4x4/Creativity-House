APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Extra credentialed CORS origins (comma-separated). Production domains are
# also hard-coded in config/cors.php. Do NOT use wildcards with credentials.
# CORS_ALLOWED_ORIGINS=https://creativity-house.vercel.app
# Optional regex (avoid *.vercel.app wildcards unless you fully understand the risk):
# CORS_ORIGIN_PATTERN=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: localhost | Production (cross-site Vercel↔Railway): leave empty/null
SESSION_DOMAIN=localhost
# Local: SameSite=lax, secure unset/false
# Production cross-site cookies REQUIRED:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
SESSION_SAME_SITE=lax

# Local SPA hosts (no protocol). Production: add your Vercel host(s), e.g.
# SANCTUM_STATEFUL_DOMAINS=creativity-house.vercel.app,localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Production Railway example (no protocol, comma-separated):
# FRONTEND_URL=https://creativity-house.vercel.app
# SANCTUM_STATEFUL_DOMAINS=creativity-house.vercel.app,localhost,localhost:3000
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
# APP_URL=https://creativity-house-production.up.railway.app


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Rate limiting uses the cache store — must be persistent (database|file|redis), never array.
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Fail fast when SMTP is unreachable (seconds). Prevents form endpoints from hanging.
MAIL_TIMEOUT=3
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# After Google callback, the SPA exchanges a one-time code via POST /api/auth/google/exchange
# so the Sanctum session cookie is set on the same path the browser uses (Vercel /api rewrite).

# Google reCAPTCHA v3 (score-based). Leave empty locally to skip verification.
# Create a v3 key pair at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Stripe ──
# Publishable key (also mirrored on Next as NEXT_PUBLIC_STRIPE_KEY).
# Secret key powers PaymentIntents + Checkout Sessions (never expose to the browser).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Meta Conversions API (CAPI) ──
# Pixel ID + system user access token from Meta Events Manager / Business Settings.
# event_id from the browser (GTM dataLayer) must match CAPI for deduplication.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE= # Used for staging/testing inside Meta Events Manager
# META_GRAPH_VERSION=v19.0

# Internal inbox for public contact / inquiry form alerts (not shown in UI).
# Public pages still display info@creativity-house.com.
CONTACT_FORM_RECIPIENT=ahmed@creativity-house.com

# ── Bunny Stream ──
# Read-only proxy for the admin curriculum video picker
# (GET /api/v1/admin/bunny/videos). The API key grants full access to the
# library, so it must never be exposed to the browser or prefixed NEXT_PUBLIC_.
# Find it in the Bunny dashboard under Stream → your library → API.
BUNNY_STREAM_LIBRARY_ID=739576
BUNNY_STREAM_API_KEY=

