# ─── Creativity House — Frontend env ───
# Copy to .env.local for WAMP, or set the same keys in the Vercel project.

# Local (WAMP / php artisan serve) — direct to Laravel (no proxy)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (Vercel):
# NEXT_PUBLIC_BACKEND_URL is used by next.config.mjs rewrites (server-side)
# and for Google OAuth redirects. Prefer relative API URL so CSRF cookies
# are first-party on your Vercel domain (fixes 419 CSRF mismatch).
#
# NEXT_PUBLIC_BACKEND_URL=https://YOUR-APP.up.railway.app
# NEXT_PUBLIC_API_URL=/api
#
# If you set an absolute Railway API URL instead, the client auto-falls back
# to same-origin `/api` in the browser when the host differs from Vercel.

# Optional reCAPTCHA (leave empty locally)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
