# ─── Creativity House — Frontend env ───
# Copy to .env.local for WAMP, or set the same keys in the Vercel project.
#
# ⚠ In Vercel: put ONLY the URL in the Value field.
#    Wrong:  NEXT_PUBLIC_API_URL=https://...
#    Right:  https://...   (or /api)

# ── Local WAMP (php artisan serve on :8000) ──
# Use localhost so Sanctum CSRF cookies match SESSION_DOMAIN=localhost.
# IPv6 hang is fixed by npm run dev (NODE_OPTIONS=--dns-result-order=ipv4first).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Production Vercel (set in Vercel dashboard) ──
# NEXT_PUBLIC_BACKEND_URL=https://creativity-house-production.up.railway.app
# NEXT_PUBLIC_API_URL=/api
#
# next.config.mjs rewrites /sanctum/* and /api/* → NEXT_PUBLIC_BACKEND_URL
# whenever the backend is NOT localhost (works in `next dev` and production).

# Google reCAPTCHA v3 site key (invisible). Leave empty locally to skip.
# Must pair with backend RECAPTCHA_SECRET_KEY from the same v3 key pair.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Stripe publishable key for Elements / Checkout (must match Laravel STRIPE_KEY mode).
# Secret key lives only on Laravel as STRIPE_SECRET.
NEXT_PUBLIC_STRIPE_KEY=

# Bunny Stream library used for iframe embeds and as the default for new
# lessons in the admin editor. This is a public identifier — the Bunny API key
# lives only on Laravel (BUNNY_STREAM_API_KEY).
NEXT_PUBLIC_BUNNY_LIBRARY_ID=739576

# Google Tag Manager container ID (@next/third-parties/google)
NEXT_PUBLIC_GTM_ID=GTM-T26L4MZX
