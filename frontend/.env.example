# ─── Creativity House — Frontend env ───
# Copy to .env.local for WAMP, or set the same keys in the Vercel project.

# Local (WAMP / php artisan serve)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (Vercel → Railway) — BOTH required; API_URL MUST end with /api
# NEXT_PUBLIC_BACKEND_URL=https://YOUR-APP.up.railway.app
# NEXT_PUBLIC_API_URL=https://YOUR-APP.up.railway.app/api

# Optional reCAPTCHA (leave empty locally)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
