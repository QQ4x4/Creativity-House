# ─── Creativity House — Frontend env ───
# Copy to .env.local for WAMP, or set the same keys in the Vercel project.

# Local (WAMP / php artisan serve) — direct to Laravel (no proxy; NODE_ENV=development)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (Vercel dashboard — REQUIRED for Sanctum CSRF rewrites):
# NEXT_PUBLIC_BACKEND_URL=https://creativity-house-production.up.railway.app
# NEXT_PUBLIC_API_URL=/api
#
# next.config.mjs rewrites /sanctum/* and /api/* → NEXT_PUBLIC_BACKEND_URL
# only when NODE_ENV=production and the backend is not localhost.

# Optional reCAPTCHA (leave empty locally)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
